{
  "name": "essen-wissen-kalender-api",
  "version": "1.0.0",
  "private": true,
  "description": "Server-API fuer den Essen-Wissen Einsatz- und Veranstaltungskalender",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql",
    "db:seed": "node scripts/seed-demo.js",
    "check": "node --check src/server.js && node --check scripts/seed-demo.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:ui": "vitest --ui"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "pg": "^8.13.1",
    "prom-client": "^15.1.0"
  },
  "devDependencies": {
    "@vitest/ui": "^5.0.0",
    "supertest": "^7.2.2",
    "vitest": "^5.0.0"
  }

}
