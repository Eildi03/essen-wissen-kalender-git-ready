{
  "name": "essen-wissen-kalender-api",
  "version": "1.0.0",
  "private": true,
  "description": "Server-API fuer den Essen-Wissen Einsatz- und Veranstaltungskalender",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -f db/schema.sql",
    "db:seed": "node scripts/seed-demo.js",
    "check": "node --check src/server.js && node --check scripts/seed-demo.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.13.1"
  }
}
